{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Threagile",
          "informationUri": "https://threagile.io",
          "version": "1.0.0",
          "rules": [
            {
              "id": "data-disclosure-pii-unencrypted-link",
              "name": "Data Disclosure - Personal Data Transmitted Over Unencrypted Channel",
              "shortDescription": {
                "text": "Personal data in transit over unencrypted communication links (plain HTTP, unencrypted database protocols, etc.) is exposed to network observers. GDPR Article 32 requires appropriate technical measures including encryption in transit."
              },
              "fullDescription": {
                "text": "Exposure of personal data to eavesdroppers, potential data breach notification obligations under GDPR Article 33, and significant regulatory penalties.\n\nMitigation: Migrate all communication links carrying PII data assets to TLS 1.2+ (preferably TLS 1.3). For internal service-to-service communication, consider mutual TLS (mTLS)."
              },
              "help": {
                "text": "Are all communication links carrying personal data encrypted in transit?"
              },
              "helpUri": "https://cheatsheetseries.owasp.org/cheatsheets/Transport_Layer_Security_Cheat_Sheet.html",
              "properties": {
                "cwe": "CWE-319",
                "function": "architecture",
                "security-severity": "6.5",
                "stride": "information-disclosure"
              }
            },
            {
              "id": "detecting-no-audit-logging",
              "name": "Detectability - PII Flows Without Audit Logging",
              "shortDescription": {
                "text": "Communication links that carry personal data without audit logging enabled mean that access to and use of personal data cannot be detected or reviewed after the fact. GDPR Article 5(2) requires demonstrable accountability.\n"
              },
              "fullDescription": {
                "text": "Inability to detect unauthorized access to personal data, failure to meet GDPR accountability obligations, and potential inability to meet breach notification deadlines.\n\n\nMitigation: Set audit_logged to true on every communication link that transmits PII data assets. Store logs in a tamper-evident system separate from the application.\n"
              },
              "help": {
                "text": "Are all communication links that carry personal data audit-logged?"
              },
              "helpUri": "https://cheatsheetseries.owasp.org/cheatsheets/Logging_Cheat_Sheet.html",
              "properties": {
                "cwe": "CWE-778",
                "function": "operations",
                "security-severity": "6.5",
                "stride": "repudiation"
              }
            },
            {
              "id": "identifying-pii-stored-unencrypted",
              "name": "Identifiability - Personal Data Stored Without Encryption at Rest",
              "shortDescription": {
                "text": "Datastores holding personal data without encryption at rest allow anyone with access to the underlying storage to read and identify data subjects. GDPR Article 32 requires appropriate security measures including encryption at rest.\n"
              },
              "fullDescription": {
                "text": "Physical or logical access to unencrypted volumes directly exposes personal data, enabling identification of natural persons and constituting a reportable data breach.\n\n\nMitigation: Enable disk-level or database-level encryption on every datastore asset that stores PII data assets. Use full-disk encryption (LUKS, AWS EBS encryption, Azure SSE) or database-level TDE (pgcrypto, SQL Server TDE).\n"
              },
              "help": {
                "text": "Is every datastore that holds personal data encrypted at rest?"
              },
              "helpUri": "https://cheatsheetseries.owasp.org/cheatsheets/Cryptographic_Storage_Cheat_Sheet.html",
              "properties": {
                "cwe": "CWE-312",
                "function": "architecture",
                "security-severity": "6.5",
                "stride": "information-disclosure"
              }
            },
            {
              "id": "linking-pii-multi-boundary",
              "name": "Linkability - Same PII Data Asset Processed Across Multiple Trust Boundaries",
              "shortDescription": {
                "text": "When the same personal-data asset is processed by technical assets in two or more different trust boundaries, an attacker who compromises any one boundary gains linkability across all others, enabling cross-context profiling.\n"
              },
              "fullDescription": {
                "text": "Aggregation of personal data enables profiling, re-identification, and violations of GDPR data minimisation and purpose limitation principles (Articles 5(1)(b) and 5(1)(c)).\n\n\nMitigation: Use per-context pseudonyms or pairwise identifiers so the same natural person cannot be linked across trust boundaries.\n"
              },
              "help": {
                "text": "Does each PII data asset appear in assets across more than one trust boundary?"
              },
              "helpUri": "https://cheatsheetseries.owasp.org/cheatsheets/Attack_Surface_Analysis_Cheat_Sheet.html",
              "properties": {
                "cwe": "CWE-359",
                "function": "architecture",
                "security-severity": "5.0",
                "stride": "information-disclosure"
              }
            },
            {
              "id": "pii-client-side-storage",
              "name": "Non-Repudiation - PII or Auth Tokens Accessible in Browser-Side Storage",
              "shortDescription": {
                "text": "Browser-based clients (SPAs, web apps) that process personal data or authentication tokens typically persist them in localStorage or sessionStorage. This browser-accessible storage is readable by any JavaScript running in the same origin — including injected scripts. Without HttpOnly cookies or a strict Content-Security-Policy, the stored tokens and PII are one XSS payload away from full exfiltration. From a LINDDUN perspective this enables Non-Repudiation attacks: an adversary who steals a token can act as the victim, making it impossible to distinguish attacker actions from legitimate user actions in audit logs.\n"
              },
              "fullDescription": {
                "text": "Stolen session tokens allow account takeover and impersonation. The original user cannot repudiate actions performed by the attacker. Stolen PII violates GDPR data minimisation and storage limitation principles.\n\n\nMitigation: Replace localStorage/sessionStorage token storage with HttpOnly, Secure, SameSite=Strict cookies. Cookies with the HttpOnly flag are inaccessible to JavaScript, eliminating the XSS token-theft vector. Deploy a strict Content-Security-Policy to limit damage from any residual XSS. Tag the asset has-httponly-session once deployed.\n"
              },
              "help": {
                "text": "Are authentication tokens stored in HttpOnly cookies rather than localStorage? Is a Content-Security-Policy header present on all pages served to this browser client?\n"
              },
              "helpUri": "https://cheatsheetseries.owasp.org/cheatsheets/HTML5_Security_Cheat_Sheet.html",
              "properties": {
                "cwe": "CWE-922",
                "function": "development",
                "security-severity": "6.5",
                "stride": "information-disclosure"
              }
            },
            {
              "id": "unawareness-no-consent-technology",
              "name": "Unawareness - PII Processed Without a Consent Management Component",
              "shortDescription": {
                "text": "When a system processes personal data from end users but has no consent-management technology in the architecture, data subjects are likely unaware of the nature and extent of processing. GDPR Articles 13 and 14 require transparent disclosure.\n"
              },
              "fullDescription": {
                "text": "Data subjects cannot exercise GDPR rights. Regulatory investigation risk and class-action exposure in jurisdictions with private right of action.\n\n\nMitigation: Introduce a consent-manager (tagged with technology consent-manager) to capture, store, and honour data-subject preferences.\n"
              },
              "help": {
                "text": "Does the architecture include a consent management component when processing PII?"
              },
              "helpUri": "https://cheatsheetseries.owasp.org/cheatsheets/Logging_Cheat_Sheet.html",
              "properties": {
                "cwe": "CWE-359",
                "function": "architecture",
                "security-severity": "6.5",
                "stride": "information-disclosure"
              }
            }
          ]
        }
      },
