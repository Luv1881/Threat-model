{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Threagile",
          "informationUri": "https://threagile.io",
          "version": "1.0.0",
          "rules": [
            {
              "id": "application-secrets-across-processes",
              "name": "Application Threat - Strictly-Confidential Asset Bridges Business Process Contexts",
              "shortDescription": {
                "text": "VAST Application Threat Model: a technical asset that supports business processes and stores or processes strictly-confidential data. Assets that bridge process contexts while holding sensitive credentials or secrets expose those secrets to any threat actor that targets any one of the supported processes, violating the least-privilege boundary between business processes.\n"
              },
              "fullDescription": {
                "text": "Credential exposure in any one process context compromises all other processes the asset supports, amplifying the breach blast radius.\n\n\nMitigation: Issue separate service accounts and credentials scoped to individual process contexts. Use a secrets manager for per-process, short-lived credentials. Consider splitting the asset into process-specific instances.\n"
              },
              "help": {
                "text": "Are strictly-confidential data assets and credentials scoped to individual business processes rather than shared via a common technical asset?\n"
              },
              "helpUri": "https://cheatsheetseries.owasp.org/cheatsheets/Secrets_Management_Cheat_Sheet.html",
              "properties": {
                "cwe": "CWE-287",
                "function": "operations",
                "security-severity": "6.5",
                "stride": "information-disclosure"
              }
            },
            {
              "id": "operational-critical-process-no-redundancy",
              "name": "Operational Threat - Critical Business Process Supported by Non-Redundant Assets",
              "shortDescription": {
                "text": "VAST Operational Threat Model: a business process classified as mission-critical or critical that is supported exclusively by technical assets with redundant=false. A single point of failure in the supporting infrastructure can take down the entire critical process, failing service level agreements and potentially causing significant financial or safety impact.\n"
              },
              "fullDescription": {
                "text": "Complete outage of a critical business process due to failure or targeted attack against the sole supporting technical asset. No failover path means maximum downtime.\n\n\nMitigation: Deploy at least two instances of each technical asset that supports mission-critical or critical business processes. Set redundant to true after adding HA configuration. Implement health checks, automatic failover, and data replication.\n"
              },
              "help": {
                "text": "Are all assets supporting critical or mission-critical business processes deployed with redundancy (redundant=true)?\n"
              },
              "helpUri": "https://cheatsheetseries.owasp.org/cheatsheets/Denial_of_Service_Cheat_Sheet.html",
              "properties": {
                "cwe": "CWE-400",
                "function": "operations",
                "security-severity": "6.5",
                "stride": "denial-of-service"
              }
            },
            {
              "id": "operational-shared-runtime-critical-process",
              "name": "Operational Threat - Critical Business Process on Shared Runtime",
              "shortDescription": {
                "text": "VAST Operational Threat Model: a business process marked as mission-critical or critical that depends on a shared runtime (container host, VM cluster) with other, lower-criticality workloads. A compromise of any co-located workload (container escape, host privilege escalation) can directly impact the critical process through shared kernel, storage, or network namespaces.\n"
              },
              "fullDescription": {
                "text": "Lateral movement from a compromised co-located workload to the infrastructure supporting a critical business process, causing service outage, data exfiltration, or integrity violations at the process level.\n\n\nMitigation: Run technical assets supporting critical or mission-critical business processes on dedicated container hosts or hypervisors not shared with untrusted workloads. Use separate node pools, VM sets, or bare-metal where process criticality demands it.\n"
              },
              "help": {
                "text": "Are technical assets supporting critical business processes isolated from shared runtimes used by lower-criticality workloads?\n"
              },
              "helpUri": "https://cheatsheetseries.owasp.org/cheatsheets/Docker_Security_Cheat_Sheet.html",
              "properties": {
                "cwe": "CWE-284",
                "function": "operations",
                "security-severity": "6.5",
                "stride": "elevation-of-privilege"
              }
            },
            {
              "id": "operational-unmonitored-critical-process",
              "name": "Operational Threat - Critical Business Process Without Operational Monitoring",
              "shortDescription": {
                "text": "VAST Operational Threat Model: a business process classified as critical or mission-critical whose supporting technical assets have no communication links with audit logging enabled. Without monitoring, security incidents within this process go undetected, incident response is hindered, and compliance with accountability requirements (GDPR Art. 5(2), SOC 2, ISO 27001 A.12.4) is undermined.\n"
              },
              "fullDescription": {
                "text": "Undetected breaches, inability to investigate incidents, compliance failures, and violation of SLA accountability requirements.\n\n\nMitigation: Set audit_logged to true on communication links feeding into technical assets that support critical business processes. Ship logs to a centralised SIEM with alerting on anomalous patterns.\n"
              },
              "help": {
                "text": "Do all assets supporting critical business processes have at least one audit-logged communication link?\n"
              },
              "helpUri": "https://cheatsheetseries.owasp.org/cheatsheets/Logging_Cheat_Sheet.html",
              "properties": {
                "cwe": "CWE-778",
                "function": "operations",
                "security-severity": "6.5",
                "stride": "repudiation"
              }
            }
          ]
        }
      },
      "results": [
