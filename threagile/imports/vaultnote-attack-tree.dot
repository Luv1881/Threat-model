digraph attack_trees {
  rankdir=LR;
  node [fontname="Helvetica"];
  "api-server" [shape=box, style=filled, fillcolor="#ffd9d9"];
  "aws-api-gateway" [shape=box, style=filled, fillcolor="#ffb3b3"];
  "aws-ses" [shape=box, style=filled, fillcolor="#ffb3b3"];
  "browser-spa" [shape=box, style=filled, fillcolor="#ffb3b3"];
  "llm-summarizer" [shape=box, style=filled, fillcolor="#ffb3b3"];
  "minio-storage" [shape=box, style=filled, fillcolor="#ffd9d9"];
  "nginx-proxy" [shape=box, style=filled, fillcolor="#ffd9d9"];
  "postgresql-db" [shape=box, style=filled, fillcolor="#ffd9d9"];
  "rag-pipeline" [shape=box, style=filled, fillcolor="#ffd9d9"];
  "redis-cache" [shape=box, style=filled, fillcolor="#ffd9d9"];
  "vector-store" [shape=box, style=filled, fillcolor="#ffd9d9"];
  "api-server" -> "minio-storage" [label="MinIO File Storage"];
  "api-server" -> "postgresql-db" [label="PostgreSQL Connection"];
  "api-server" -> "redis-cache" [label="Redis Session Store"];
  "aws-api-gateway" -> "api-server" [label="Route to ECS API"];
  "browser-spa" -> "nginx-proxy" [label="HTTPS to Nginx"];
  "llm-summarizer" -> "rag-pipeline" [label="Call RAG Pipeline"];
  "llm-summarizer" -> "vector-store" [label="Query Vector Store"];
  "nginx-proxy" -> "api-server" [label="HTTP to API Server"];
}
