#!/bin/sh
# Managed by 'threagile hooks install' — threat-model guardrail (pre-commit).
# Re-run 'threagile hooks install --force' to regenerate, or delete this file.
set -e
THREAGILE='/home/coder221/Desktop/coding/better-threagile/bin/threagile'
MODEL='/tmp/tmp.OI1HUDpG6L/threagile.yaml'
# No model in this repo yet? Then there is nothing to check.
[ -f "$MODEL" ] || exit 0
echo "threagile: checking threat model $MODEL"
"$THREAGILE" validate --model "$MODEL"
"$THREAGILE" lint --model "$MODEL"
