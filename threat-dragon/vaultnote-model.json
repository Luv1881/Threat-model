          {
            "position": { "x": 65, "y": 250 },
            "size": { "width": 130, "height": 60 },
            "attrs": {
              "text": { "text": "Browser\n(React SPA)" },
              "body": { "stroke": "#333333", "strokeWidth": 1.5, "strokeDasharray": null }
            },
            "visible": true,
            "shape": "actor",
            "ports": {
              "groups": {
                "top":    { "position": "top",    "attrs": { "circle": { "r": 4, "magnet": true, "stroke": "#5F95FF", "strokeWidth": 1, "fill": "#fff", "style": { "visibility": "hidden" } } } },
                "right":  { "position": "right",  "attrs": { "circle": { "r": 4, "magnet": true, "stroke": "#5F95FF", "strokeWidth": 1, "fill": "#fff", "style": { "visibility": "hidden" } } } },
                "bottom": { "position": "bottom", "attrs": { "circle": { "r": 4, "magnet": true, "stroke": "#5F95FF", "strokeWidth": 1, "fill": "#fff", "style": { "visibility": "hidden" } } } },
                "left":   { "position": "left",   "attrs": { "circle": { "r": 4, "magnet": true, "stroke": "#5F95FF", "strokeWidth": 1, "fill": "#fff", "style": { "visibility": "hidden" } } } }
              },
              "items": [
                { "group": "top",    "id": "browser-port-top" },
                { "group": "right",  "id": "browser-port-right" },
                { "group": "bottom", "id": "browser-port-bottom" },
                { "group": "left",   "id": "browser-port-left" }
              ]
            },
            "id": "browser",
            "zIndex": 2,
            "data": {
              "type": "tm.Actor",
              "name": "Browser (React SPA)",
              "description": "React Single Page Application running in the end-user's browser. Handles authentication, note management, and file uploads through the Nginx-fronted API.",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "providesAuthentication": false,
              "threats": [
                {
                  "id": "threat-001",
                  "title": "Stored Cross-Site Scripting (XSS)",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "An attacker creates a note containing malicious JavaScript. When another user views that note, the script executes in their browser context, enabling session token exfiltration, credential harvesting, or account takeover via forged API requests.",
                  "mitigation": "Enforce a strict Content Security Policy (CSP) header from Nginx. Use React's default HTML escaping and never bypass it with dangerouslySetInnerHTML. Sanitise user-provided note content server-side with DOMPurify before storage.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 1,
                  "score": ""
                },
                {
                  "id": "threat-002",
                  "title": "Session Token Theft via Browser Storage",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Information Disclosure",
                  "description": "If the JWT is stored in localStorage (rather than an HttpOnly cookie) it is accessible to any JavaScript running on the page, including XSS payloads or malicious browser extensions.",
                  "mitigation": "Store the JWT in an HttpOnly, Secure, SameSite=Strict cookie. If localStorage is required for UX reasons, implement a short TTL and token rotation on every request.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 2,
                  "score": ""
                }
              ]
            }
          },

          {
            "position": { "x": 295, "y": 230 },
            "size": { "width": 130, "height": 100 },
            "attrs": {
              "text": { "text": "Nginx\nReverse Proxy" },
              "body": { "stroke": "#333333", "strokeWidth": 1.5, "strokeDasharray": null }
            },
            "visible": true,
            "shape": "process",
            "ports": {
              "groups": {
                "top":    { "position": "top",    "attrs": { "circle": { "r": 4, "magnet": true, "stroke": "#5F95FF", "strokeWidth": 1, "fill": "#fff", "style": { "visibility": "hidden" } } } },
                "right":  { "position": "right",  "attrs": { "circle": { "r": 4, "magnet": true, "stroke": "#5F95FF", "strokeWidth": 1, "fill": "#fff", "style": { "visibility": "hidden" } } } },
                "bottom": { "position": "bottom", "attrs": { "circle": { "r": 4, "magnet": true, "stroke": "#5F95FF", "strokeWidth": 1, "fill": "#fff", "style": { "visibility": "hidden" } } } },
                "left":   { "position": "left",   "attrs": { "circle": { "r": 4, "magnet": true, "stroke": "#5F95FF", "strokeWidth": 1, "fill": "#fff", "style": { "visibility": "hidden" } } } }
              },
              "items": [
                { "group": "top",    "id": "nginx-port-top" },
                { "group": "right",  "id": "nginx-port-right" },
                { "group": "bottom", "id": "nginx-port-bottom" },
                { "group": "left",   "id": "nginx-port-left" }
              ]
            },
            "id": "nginx",
            "zIndex": 2,
            "data": {
              "type": "tm.Process",
              "name": "Nginx Reverse Proxy",
              "description": "Nginx terminates TLS on port 443 and reverse-proxies all API traffic to Express over plain HTTP on port 3000. Also serves the static React build. Single external entry point.",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "handlesCardPayment": false,
              "handlesGoodsOrServices": false,
              "isWebApplication": false,
              "privilegeLevel": "",
              "threats": [
                {
                  "id": "threat-006",
                  "title": "TLS Downgrade / Weak Cipher Suite",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Tampering",
                  "description": "A self-signed certificate with a weak configuration (TLS 1.0/1.1 or weak ciphers) allows an attacker on the network to downgrade or intercept the HTTPS session between the browser and Nginx.",
                  "mitigation": "Enforce TLS 1.2+ with strong cipher suites (ECDHE-ECDSA-AES256-GCM-SHA384). Use ssl_prefer_server_ciphers on. Rotate to a CA-signed certificate for production. Add HSTS header.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 6,
                  "score": ""
                },
                {
                  "id": "threat-007",
                  "title": "No Web Application Firewall — Unfiltered Requests",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Elevation of Privilege",
                  "description": "Nginx proxies all requests to the API without inspecting payloads. Common attack patterns (SQLi, XSS, path traversal) reach the API unfiltered, reducing defence depth.",
                  "mitigation": "Deploy ModSecurity with the OWASP Core Rule Set (CRS) as a Nginx WAF module. At minimum, enforce request size limits and rate limiting at the Nginx layer.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 7,
                  "score": ""
                }
              ]
            }
          },

          {
            "position": { "x": 525, "y": 230 },
            "size": { "width": 130, "height": 100 },
            "attrs": {
              "text": { "text": "API Server\n(Node.js/Express)" },
              "body": { "stroke": "#333333", "strokeWidth": 1.5, "strokeDasharray": null }
            },
            "visible": true,
            "shape": "process",
            "ports": {
              "groups": {
                "top":    { "position": "top",    "attrs": { "circle": { "r": 4, "magnet": true, "stroke": "#5F95FF", "strokeWidth": 1, "fill": "#fff", "style": { "visibility": "hidden" } } } },
                "right":  { "position": "right",  "attrs": { "circle": { "r": 4, "magnet": true, "stroke": "#5F95FF", "strokeWidth": 1, "fill": "#fff", "style": { "visibility": "hidden" } } } },
                "bottom": { "position": "bottom", "attrs": { "circle": { "r": 4, "magnet": true, "stroke": "#5F95FF", "strokeWidth": 1, "fill": "#fff", "style": { "visibility": "hidden" } } } },
                "left":   { "position": "left",   "attrs": { "circle": { "r": 4, "magnet": true, "stroke": "#5F95FF", "strokeWidth": 1, "fill": "#fff", "style": { "visibility": "hidden" } } } }
              },
              "items": [
                { "group": "top",    "id": "api-port-top" },
                { "group": "right",  "id": "api-port-right" },
                { "group": "bottom", "id": "api-port-bottom" },
                { "group": "left",   "id": "api-port-left" }
              ]
            },
            "id": "api",
            "zIndex": 2,
            "data": {
              "type": "tm.Process",
              "name": "API Server (Node.js/Express)",
              "description": "REST API handling JWT authentication (bcrypt), notes CRUD, and file upload/download via MinIO. Bridges frontend-net and backend-net Docker networks — highest-risk pivot point.",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "handlesCardPayment": false,
              "handlesGoodsOrServices": false,
              "isWebApplication": true,
              "privilegeLevel": "",
              "threats": [
                {
                  "id": "threat-008",
                  "title": "SQL Injection via Note CRUD Endpoints",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "If any SQL query constructs user input by string concatenation rather than parameterised queries, an attacker can dump the users table, bypass authentication, or delete data.",
                  "mitigation": "Use parameterised queries exclusively via the pg library ($1 placeholders). Verify this consistently across all routes including search. Create a least-privilege DB user with no DDL permissions.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 8,
                  "score": ""
                },
                {
                  "id": "threat-009",
                  "title": "Broken Authentication — Hardcoded JWT Secret",
                  "status": "Open",
                  "severity": "High",
                  "type": "Elevation of Privilege",
                  "description": "The JWT signing secret is hardcoded as 'change-me-in-production' in docker-compose.yml. Anyone with repository access can forge valid JWT tokens for any user.",
                  "mitigation": "Inject the JWT secret via environment variable from a secrets manager. Enforce minimum 256-bit entropy. Rotate and invalidate all sessions as part of the production deployment checklist.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 9,
                  "score": ""
                },
                {
                  "id": "threat-010",
                  "title": "Server-Side Request Forgery (SSRF) via File Upload",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "If the file upload endpoint accepts a URL parameter without validating the destination, an attacker can cause the server to make requests to internal services including the MinIO admin API, Redis, PostgreSQL, or the cloud metadata endpoint (169.254.169.254).",
                  "mitigation": "Never accept user-controlled URLs for server-side fetch. Generate presigned MinIO URLs server-side with a fixed bucket path. Block access to 169.254.169.254 and RFC1918 ranges at the network level.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 10,
                  "score": ""
                },
                {
                  "id": "threat-011",
                  "title": "Brute Force Login — No Rate Limiting",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Denial of Service",
                  "description": "The login endpoint does not enforce per-IP or per-account rate limiting. An attacker can attempt millions of password combinations without triggering any lock-out, enabling credential stuffing.",
                  "mitigation": "Apply express-rate-limit to /auth/login: max 5 attempts per 15 minutes per IP. Implement account-level lock-out after 10 consecutive failures. Store counters in Redis so they survive API restarts.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 11,
                  "score": ""
                }
              ]
            }
          },

