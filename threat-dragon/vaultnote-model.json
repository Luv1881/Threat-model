                { "group": "bottom", "id": "redis-port-bottom" },
                { "group": "left",   "id": "redis-port-left" }
              ]
            },
            "id": "redis",
            "zIndex": 2,
            "data": {
              "type": "tm.Store",
              "name": "Redis (Session Store)",
              "description": "In-memory store for active JWT session tokens and JWT revocation list. Password-protected (requirepass) but no TLS. Non-persistent by default.",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "isALog": false,
              "isEncrypted": false,
              "isSigned": false,
              "storesCredentials": false,
              "storesInventory": false,
              "threats": [
                {
                  "id": "threat-014",
                  "title": "Session Hijacking via Redis Exposure",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Elevation of Privilege",
                  "description": "If Redis becomes network-accessible outside backend-net, an attacker can extract all active session tokens and replay them without knowing user passwords. The revocation list can also be flushed, re-enabling previously revoked tokens.",
                  "mitigation": "Bind Redis exclusively to backend-net. Enforce requirepass (already configured). Enable Redis ACLs to restrict the API user to only GET, SET, DEL, EXPIRE. Consider enabling Redis TLS for the API-to-Redis connection.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 14,
                  "score": ""
                }
              ]
            }
          },

          {
