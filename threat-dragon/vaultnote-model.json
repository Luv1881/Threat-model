                { "group": "right",  "id": "pg-port-right" },
                { "group": "bottom", "id": "pg-port-bottom" },
                { "group": "left",   "id": "pg-port-left" }
              ]
            },
            "id": "postgres",
            "zIndex": 2,
            "data": {
              "type": "tm.Store",
              "name": "PostgreSQL",
              "description": "Primary relational datastore: users table (email, bcrypt hash), notes table, attachments metadata. On backend-net with no direct external exposure.",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "isALog": false,
              "isEncrypted": false,
              "isSigned": false,
              "storesCredentials": true,
              "storesInventory": false,
              "threats": [
                {
                  "id": "threat-012",
                  "title": "No Encryption at Rest — PII and Credentials Exposed",
                  "status": "Open",
                  "severity": "High",
                  "type": "Information Disclosure",
                  "description": "PostgreSQL stores all user PII (email), bcrypt password hashes, and note content without encryption at rest. If the Docker volume is exfiltrated, all data is immediately readable.",
                  "mitigation": "Enable filesystem-level encryption (LUKS) on the host volume backing pgdata. Use pgcrypto for column-level encryption of sensitive fields. Ensure backups are encrypted in transit and at rest.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 12,
                  "score": ""
                },
                {
                  "id": "threat-013",
                  "title": "Overprivileged Database User",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Elevation of Privilege",
                  "description": "The API connects as the vaultnote superuser. A compromised API grants full PostgreSQL privileges including CREATE/DROP TABLE, pg_read_file, and COPY TO — enabling arbitrary file reads from the host.",
                  "mitigation": "Create a least-privilege application role with SELECT/INSERT/UPDATE/DELETE on specific tables only. Run schema migrations as a separate migration user not accessible to the running API.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 13,
                  "score": ""
                }
              ]
            }
          },

