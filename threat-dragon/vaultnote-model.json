                { "group": "top",    "id": "minio-port-top" },
                { "group": "right",  "id": "minio-port-right" },
                { "group": "bottom", "id": "minio-port-bottom" },
                { "group": "left",   "id": "minio-port-left" }
              ]
            },
            "id": "minio",
            "zIndex": 2,
            "data": {
              "type": "tm.Store",
              "name": "MinIO (Object Storage)",
              "description": "S3-compatible object store for user file attachments. Configured with default minioadmin/minioadmin credentials. No encryption at rest or in transit within the Docker network.",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "isALog": false,
              "isEncrypted": false,
              "isSigned": false,
              "storesCredentials": false,
              "storesInventory": false,
              "threats": [
                {
                  "id": "threat-015",
                  "title": "Unauthorized File Access via Default Credentials",
                  "status": "Open",
                  "severity": "High",
                  "type": "Information Disclosure",
                  "description": "MinIO is configured with default credentials minioadmin/minioadmin visible in docker-compose.yml and committed to source control. Any process on backend-net can authenticate, enumerate all buckets, and download every stored file.",
                  "mitigation": "Rotate the MinIO root credentials via a secrets manager. Create a dedicated service account for the API with a scoped bucket policy. Never commit credentials to source control.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 15,
                  "score": ""
                },
                {
                  "id": "threat-016",
                  "title": "Path Traversal via File Download Endpoint",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "If the download endpoint constructs the MinIO object key directly from user-provided input without normalisation, an attacker can traverse to another user's objects or system paths.",
                  "mitigation": "Store files under a UUID-based key ({userId}/{uuid}.{ext}) rather than the original filename. Validate the requested key belongs to the authenticated user before issuing a presigned URL.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 16,
                  "score": ""
                }
              ]
            }
          },

