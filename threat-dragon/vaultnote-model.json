  "summary": {
    "title": "VaultNote Threat Model",
    "owner": "VaultNote Security Team",
    "description": "Threat model for VaultNote — a containerised note-taking application comprising a React SPA, Nginx reverse proxy, Node.js/Express REST API, PostgreSQL database, Redis session store, and MinIO object storage. Contains intentional misconfigurations to demonstrate STRIDE-based threat identification.",
    "id": 0
  },
